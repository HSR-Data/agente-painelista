# Modelo do arquivo de configuração.
# Você NÃO precisa preencher isto: peça o arquivo .env pronto para quem te passou a ferramenta
# e cole-o nesta pasta. Este exemplo só mostra quais valores o .env contém.
#
# ─── Conexão com o SQL Server ─────────────────────────────────────────
DB_SERVER=              # endereço do SQL Server (IP ou hostname)
DB_PORT=1433            # porta (1433 é o padrão)
DB_USER=                # usuário do banco
DB_PASSWORD=            # senha do banco
DB_DATABASE=            # nome do banco de dados
