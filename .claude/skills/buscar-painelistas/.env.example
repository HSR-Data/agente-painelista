# Modelo do arquivo de credenciais. Copie para .env (na pasta em que você abre o Claude Code,
# ou em qualquer lugar apontado por PAINELISTA_ENV_FILE) e preencha os valores.
# Não coloque o .env preenchido dentro da pasta da skill: ela pode ser atualizada por cima.
#
# ─── Conexão com o SQL Server ─────────────────────────────────────────
DB_SERVER=              # endereço do SQL Server (IP ou hostname)
DB_PORT=1433            # porta (1433 é o padrão)
DB_USER=                # usuário do banco
DB_PASSWORD=            # senha do banco
DB_DATABASE=            # nome do banco de dados
